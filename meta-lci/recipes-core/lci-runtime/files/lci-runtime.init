#!/bin/sh

DAEMON=/usr/local/natinst/bin/vb8034Daemon
NAME=vb8034Daemon
PREPARE=@LIBEXECDIR@/lci-runtime-prepare

case "$1" in
    start)
        test -x "$DAEMON" || exit 0
        $PREPARE || exit $?
        # The daemon runs its DMA poll threads at SCHED_FIFO max priority.
        ulimit -r 99
        start-stop-daemon -S -q -o -b -c lvuser:ni -n "$NAME" -a "$DAEMON"
        ;;
    stop)
        start-stop-daemon -K -q -n "$NAME"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac

exit 0
