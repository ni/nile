@@ -0,0 +1,310 @@
+"""
+BitBake nuget fetcher implementation
+
+SRC_URI = "nuget://REGISTRY/PACKAGE/VERSION;OptionA=xxx;OptionB=xxx;..."
+
+Downloads a nuget package named PACKAGE with version VERSION from REGISTRY.
+The default "nuget.org" registry is preloaded; others may be added by setting
+the environment variable NUGET_REGISTRY_name to the registry's service index
+URL. (This functions similarly to <packageSources> in NuGet.exe's configuration.)
+
+Supported SRC_URI options are:
+
+- downloadfilename
+    Specifies the filename used when storing the downloaded file.
+
+This fetcher uses the nuget v3 API's SearchQueryService to look up a package
+id/version; this does require a few extra URL hops to get us to a download URL.
+
+The nuget v3 API does have a PackageBaseAddress service that would be a more
+direct path to a download URL, but unfortunately, Artifactory does not support
+it in all cases (it requires a sercer-side "NuGet Restore Layout" setting), so
+we have to do the search route.
+See https://github.com/dependabot/dependabot-core/issues/8887#issuecomment-1935082966
+where they also ran into this.
+"""
+# Copyright (C) 2026 National Instruments
+#
+# Based on bb.fetch2.wget and bb.fetch2.npm.
+#
+# SPDX-License-Identifier: GPL-2.0-only
+
+import base64
+import json
+import os
+import re
+import tempfile
+import bb
+import urllib
+import zipfile
+from bb.fetch2 import Fetch
+from bb.fetch2 import FetchError
+from bb.fetch2 import FetchMethod
+from bb.fetch2 import MalformedUrl
+from bb.fetch2 import MissingParameterError
+from bb.fetch2 import ParameterError
+from bb.fetch2 import runfetchcmd
+from bb.fetch2 import URI
+from bb.fetch2.wget import Wget
+from bb.utils import is_semver
+
+class Nuget(Wget):
+    """Class to fetch a package from a nuget repository"""
+
+    KNOWN_REGISTRIES = {
+        'nuget.org': 'https://api.nuget.org/v3/index.json',
+    }
+
+    def __init__(self, *args, **kwargs):
+        super(Nuget, self).__init__(*args, **kwargs)
+
+        self.search_query_sources = {}
+
+    def _service_index_url(self, ud, d):
+        index_url = d.getVar("NUGET_REGISTRY_%s" % ud.registry)
+        if not index_url and ud.registry in self.KNOWN_REGISTRIES:
+            index_url = self.KNOWN_REGISTRIES[ud.registry]
+
+        if not index_url:
+            raise ParameterError("Unknown nuget registry '%s'; set NUGET_REGISTRY_%s to the service index URL." % (ud.registry, ud.registry), ud.url)
+
+        return index_url
+
+    def _fetch_resource(self, ud, d, uri, suffix="resource"):
+        # directly invoke wget to retrieve resource data to traverse the index
+
+        bb.debug(1, "Fetching %s content from %s" % (suffix, uri))
+        f = tempfile.NamedTemporaryFile()
+        with tempfile.TemporaryDirectory(prefix="nuget-%s-" % suffix) as workdir, tempfile.NamedTemporaryFile(dir=workdir, prefix="nuget-%s" % suffix) as f:
+            fetchcmd = self.basecmd
+            fetchcmd += " -O " + f.name + " --user-agent='" + self.user_agent + "' '" + uri + "'"
+            fetchcmd += " --compression=auto"
+
+            json_text = ""
+            try:
+                self._runwget(ud, d, fetchcmd, True, workdir=workdir)
+                json_text = f.read().decode()
+                json_result = json.loads(json_text)
+                return json_result
+            except json.decoder.JSONDecodeError:
+                raise FetchError("Unable to parse %s response as json" % suffix, uri)
+
+        return None
+
+    def _get_search_query_service_url(self, ud, d, registry):
+        # if we've previously found the url for SearchQueryService, use it
+        if registry in self.search_query_sources:
+            return self.search_query_sources[registry]
+
+        service_index_url = self._service_index_url(ud, d)
+        service_index = self._fetch_resource(ud, d, service_index_url, suffix="service-index")
+
+        # parse the service index:
+        # https://learn.microsoft.com/en-us/nuget/api/service-index
+        if not 'version' in service_index:
+            raise FetchError("Service index json doesn't have a version key; Is this a nuget repository?", service_index_url)
+        if not 'resources' in service_index:
+            raise FetchError("Service index json doesn't have a resources key; Is this a nuget repository?", service_index_url)
+
+        for rsrc in service_index['resources']:
+            if not '@type' in rsrc:
+                raise FetchError("Service resource is missing @type", service_index_url)
+            if not '@id' in rsrc:
+                raise FetchError("Service resource is missing @id", service_index_url)
+            if rsrc['@type'].startswith("SearchQueryService/"):
+                # cache the url so we don't need to look it up again
+                self.search_query_service = rsrc['@id']
+                return rsrc['@id']
+
+        raise FetchError("Unable to find SearchQueryResource in service index.", service_index_url)
+
+    def _get_package_download_url(self, ud, d, registry, package, version):
+        search_query_service = self._get_search_query_service_url(ud, d, registry)
+        # Build a search query to find our package by id
+        # https://learn.microsoft.com/en-us/nuget/api/search-query-service-resource
+        #
+        # The query string is not well-specified, and different servers may interpret
+        # it differently. nuget.org seems to have trouble returning anything but the
+        # current version of a package, even when we specify 'version:x.y.z'
+        # as documented.
+        search_query_url = (self.search_query_service + '?q=' +
+            urllib.parse.quote(package) + '&semVerLevel=2.0.0&prerelease=true')
+        listing_data = self._fetch_resource(ud, d, search_query_url, suffix='package-query')
+
+        package_metadata_url = None
+        # Look through the listing to find the package that actually exact-matches
+        # the id we were looking for (instead of a substring match like how nuget.org
+        # seems to treat queries)
+        for package_data in listing_data['data']:
+            if package_data['id'] == package:
+                if version == "latest":
+                    version = package_data['version']
+
+                # Look through all the versions to find the one that matches
+                bb.debug(1, "found package %s in metadata" % package)
+                for ver in package_data['versions']:
+                    if ver['version'] == version:
+                        package_metadata_url = ver['@id']
+                        break;
+
+        if package_metadata_url is None:
+            raise FetchError("Unable to find package %s version %s" % (package, version), search_query_url)
+
+        version_listing_data = self._fetch_resource(ud, d, package_metadata_url, suffix='package-md-query')
+
+        download_url = version_listing_data['packageContent']
+
+        bb.debug(1, "packageContent URL for package: %s" % download_url)
+
+        return download_url
+
+    def supports(self, ud, d):
+        """Check if a given url can be fetched with nuget"""
+        return ud.type in ["nuget"]
+
+    def urldata_init(self, ud, d):
+        """Init nuget specific variables within url data"""
+        super(Nuget, self).urldata_init(ud, d)
+
+        # URL syntax is: nuget://[user@pass:]REGISTRY/PACKAGE/VERSION;options
+        # superclass urldata_init has already done decodeurl() for some of this but
+        # we need to break up the path.
+        ud.registry = ud.host;
+        parts = ud.path.split('/')
+        if len(parts) < 3:
+            raise MalformedUrl("Invalid URL: Must be nuget://REGISTRY/NAME/VERSION", ud.url)
+
+        ud.package = parts[1]
+        ud.version = parts[2]
+
+        if not ud.registry:
+            raise MissingParameterError("registry", ud.url)
+
+        if not ud.package:
+            raise MissingParameterError("package", ud.url)
+
+        if not ud.version:
+            raise MissingParameterError("version", ud.url)
+
+        registry_requires_semver = int(d.getVar("NUGET_REGISTRY_%s_SEMVER" % ud.registry) or "1")
+
+        if registry_requires_semver and (not is_semver(ud.version) and ud.version != "latest"):
+            raise ParameterError("Version parameter is invalid", ud.url)
+
+        # superclass urldata_init set default basename based on path, we need to reset it
+        if 'downloadfilename' in ud.parm:
+            ud.basename = ud.parm['downloadfilename']
+        else:
+            ud.basename = "%s-%s.nupkg" % (ud.package, ud.version)
+
+        ud.localfile = os.path.join("nuget", d.expand(urllib.parse.unquote(ud.basename)))
+
+        # This fetcher resolves a real download URI using the package name and version,
+        # then passes it along to the wget fetcher. Similar to the npm fetcher, create
+        # a resolve file with the resolved URI to avoid unwanted network access.
+        ud.proxy = None
+        ud.needdonestamp = False
+        ud.resolvefile = self.localpath(ud, d) + ".resolved"
+
+    def _resolve_proxy_url(self, ud, d):
+        """Fetch urls"""
+
+        uri = URI(self._get_package_download_url(ud, d, ud.registry, ud.package, ud.version))
+
+        uri.params["downloadfilename"] = ud.localfile
+        for checksum_id in [ "md5sum", "sha256sum", "sha1sum", "sha384sum", "sha512sum" ]:
+            if checksum_id in ud.parm:
+                uri.params[checksum_id] = ud.parm[checksum_id]
+
+        bb.utils.mkdirhier(os.path.dirname(ud.resolvefile))
+        with open(ud.resolvefile, "w") as f:
+            f.write(str(uri))
+
+    def _setup_proxy(self, ud, d):
+        if ud.proxy is None:
+            if not os.path.exists(ud.resolvefile):
+                self._resolve_proxy_url(ud, d)
+
+            with open(ud.resolvefile, "r") as f:
+                url = f.read()
+
+            # Avoid conflicts between the environment data and:
+            # - the proxy url checksum
+            data = bb.data.createCopy(d)
+            data.delVarFlags("SRC_URI")
+            ud.proxy = Fetch([url], data)
+
+    def _get_proxy_method(self, ud, d):
+        self._setup_proxy(ud, d)
+        proxy_url = ud.proxy.urls[0]
+        proxy_ud = ud.proxy.ud[proxy_url]
+        proxy_d = ud.proxy.d
+        proxy_ud.setup_localpath(proxy_d)
+        return proxy_ud.method, proxy_ud, proxy_d
+
+    def verify_donestamp(self, ud, d):
+        """Verify the donestamp file"""
+        proxy_m, proxy_ud, proxy_d = self._get_proxy_method(ud, d)
+        return proxy_m.verify_donestamp(proxy_ud, proxy_d)
+
+    def update_donestamp(self, ud, d):
+        """Update the donestamp file"""
+        proxy_m, proxy_ud, proxy_d = self._get_proxy_method(ud, d)
+        proxy_m.update_donestamp(proxy_ud, proxy_d)
+
+    def need_update(self, ud, d):
+        """Force a fetch, even if localpath exists ?"""
+        if not os.path.exists(ud.resolvefile):
+            return True
+        if ud.version == "latest":
+            return True
+        proxy_m, proxy_ud, proxy_d = self._get_proxy_method(ud, d)
+        return proxy_m.need_update(proxy_ud, proxy_d)
+
+    def try_mirrors(self, fetch, ud, d, mirrors):
+        """Try to use a mirror"""
+        proxy_m, proxy_ud, proxy_d = self._get_proxy_method(ud, d)
+        return proxy_m.try_mirrors(fetch, proxy_ud, proxy_d, mirrors)
+
+    def download(self, ud, d):
+        """Fetch url"""
+        self._setup_proxy(ud, d)
+        ud.proxy.download()
+
+    def unpack(self, urldata, rootdir, data):
+        try:
+            unpack = bb.utils.to_boolean(urldata.parm.get('unpack'), True)
+        except ValueError as exc:
+            bb.fatal("Invalid value for 'unpack' parameter for %s: %s" %
+                     (file, urldata.parm.get('unpack')))
+
+        # If 'subdir' param exists, create a dir and use it as destination for unpack cmd
+        if 'subdir' in urldata.parm:
+            subdir = urldata.parm.get('subdir')
+            if os.path.isabs(subdir):
+                if not os.path.realpath(subdir).startswith(os.path.realpath(rootdir)):
+                    raise UnpackError("subdir argument isn't a subdirectory of unpack root %s" % rootdir, urldata.url)
+                unpackdir = subdir
+            else:
+                unpackdir = os.path.join(rootdir, subdir)
+        else:
+            unpackdir = os.path.join(rootdir, "nuget")
+
+        bb.utils.mkdirhier(unpackdir)
+
+        with zipfile.ZipFile(urldata.localpath, mode='r') as zip:
+            zip.extractall(unpackdir)
+
+    def clean(self, ud, d):
+        """Clean any existing full or partial download"""
+        if os.path.exists(ud.resolvefile):
+            self._setup_proxy(ud, d)
+            ud.proxy.clean()
+            bb.utils.remove(ud.resolvefile)
+
+    def done(self, ud, d):
+        """Is the download done ?"""
+        if not os.path.exists(ud.resolvefile):
+            return False
+        proxy_m, proxy_ud, proxy_d = self._get_proxy_method(ud, d)
+        return proxy_m.done(proxy_ud, proxy_d)
